{
  "name": "genki-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names 'DB,PKGS,BACKEND,MOBILE' --prefix-colors 'blue,yellow,green,magenta' 'pnpm dev:db' 'pnpm dev:packages' 'pnpm dev:backend' 'pnpm dev:mobile'",
    "dev:db": "docker compose -f apps/backend/docker-compose.yml up postgres",
    "dev:packages": "concurrently --names 'types,utils,api' --prefix-colors 'cyan,blue,yellow' 'pnpm --filter @genki/types dev' 'pnpm --filter @genki/utils dev' 'pnpm --filter @genki/api-client dev'",
    "dev:backend": "pnpm --filter @genki/backend dev",
    "dev:mobile": "pnpm --filter @genki/mobile start",
    "build": "turbo run build",
    "build:packages": "pnpm --filter @genki/types --filter @genki/utils --filter @genki/api-client run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "turbo": "^2.0.4"
  },
  "pnpm": {
    "overrides": {
      "react-native-css-interop": "^0.1.22",
      "react": "18.2.0",
      "react-native": "0.74.5",
      "react-native-safe-area-context": "4.10.5"
    }
  }
}
